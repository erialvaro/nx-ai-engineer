# {{project_title}} — environment (Twelve-Factor: all config lives here).
# Copy to `.env` and fill in. NEVER commit the real `.env`.

# --- App ---------------------------------------------------------------------
APP_ENV=development            # development | staging | production
LOG_LEVEL=info                 # debug | info | warning | error
SECRET_KEY=changeme-in-production

# --- Ports (host side) -------------------------------------------------------
BACKEND_PORT={{backend_port}}
FRONTEND_PORT={{frontend_port}}

# --- Database: Supabase (free tier) ------------------------------------------
# Create a project at https://supabase.com — Settings > API gives these values.
DB_BACKEND=supabase            # supabase | postgres (future swap, no code change)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Direct PostgreSQL (only used when DB_BACKEND=postgres) -------------------
DATABASE_URL=postgresql://user:changeme@db:5432/app

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:{{backend_port}}
